<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aproperties="clr-namespace:CShroudApp.Desktop.Resources.AttachedProperties"
        xmlns:widgets="clr-namespace:CShroudApp.Desktop.Widgets">
    <Design.PreviewWith>
        <StackPanel Width="350"
                    Height="350" Background="#fff">
            <Button Classes="IconButton" Content="Sexufrau" Height="128" Background="Red" BorderBrush="Green" Foreground="#2f7cff" aproperties:IconProperties.IconPath="avares://CShroudApp.Desktop/Assets/icons/svg/fast-forward.svg">
            </Button>
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="Button.ButtonColorSkyBlue">
        <Style Selector="^ Svg.ButtonTypeIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
            
        <Style Selector="^ TextBlock.ButtonTypeText">
            <Setter Property="Foreground" Value="#2F7CFF"/>
        </Style>
            
        <Style Selector="^ Svg.ButtonTypeIcon">
            <Setter Property="Css" Value="* { fill: #2F7CFF}"/>
        </Style>
    </Style>
    
    <Style Selector="Button.ButtonType4">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#4d1a1a1a"/>
        <Setter Property="BorderBrush" Value="#1a1a1a"/>
        <Setter Property="CornerRadius" Value="6.75"/>
        <Setter Property="Cursor" Value="Hand"/>
            
        <Style Selector="^ StackPanel.ButtonTypeWrapper">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="14"/>
        </Style>
            
        <Style Selector="^ Svg.ButtonTypeIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
            
        <Style Selector="^ TextBlock.ButtonTypeText">
            <Setter Property="LineHeight" Value="17.4999825"/>
            <Setter Property="FontSize" Value="12.25"/>
        </Style>
            
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#801a1a1a"/>
            <Setter Property="BorderBrush" Value="#1a1a1a"/>
        </Style>
            
        <Style Selector="^:pointerover">
            <Style Selector="^ TextBlock.ButtonTypeText">
                <Setter Property="Foreground" Value="#f5f5f5"/>
            </Style>
            
            <Style Selector="^ Svg.ButtonTypeIcon">
                <Setter Property="Css" Value="* { fill: #f5f5f5}"/>
            </Style>
        </Style>
    </Style>
    
    
    
    <Style Selector="Button.IconButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Button>
                    <StackPanel Classes="Wrapper">
                        <Svg Classes="Icon"
                             Path="{TemplateBinding aproperties:IconProperties.IconPath}"/>
                        <TextBlock Classes="Text" Text="{TemplateBinding Content}"/>
                    </StackPanel>
                </Button>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
            <Setter Property="Height" Value="{TemplateBinding Height}"/>
            <Setter Property="Width" Value="{TemplateBinding Width}"/>
            <Setter Property="CornerRadius" Value="6.75"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="^ /template/ StackPanel.Wrapper">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="14"/>
        </Style>
        
        <Style Selector="^ /template/ Svg.Icon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Css" Value="{TemplateBinding Foreground, Converter={StaticResource ColorToCss}}"/>
        </Style>
        
        <Style Selector="^ /template/ TextBlock.Text">
            <Setter Property="LineHeight" Value="17.4999825"/>
            <Setter Property="FontSize" Value="12.25"/>
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Style>
    
    <Style Selector="widgets|IconButton.IconButtonType1">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#4d1a1a1a"/>
        <Setter Property="BorderBrush" Value="#1a1a1a"/>
        <Setter Property="CornerRadius" Value="6.75"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IconColor" Value="{Binding (aproperties:ColorProperties.MainColor), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{Binding (aproperties:ColorProperties.MainColor),
                        RelativeSource={RelativeSource Self},
                        Converter={StaticResource ColorToBrush}}"/>
        <Setter Property="IconWidth" Value="14"/>
        <Setter Property="IconHeight" Value="14"/>
        <Setter Property="Gap" Value="14"/>
        <Setter Property="LineHeight" Value="17.4999825"/>
        <Setter Property="FontSize" Value="12.25"/>
        <Setter Property="Padding" Value="8.750 0"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="IconColor" Value="#FFFFFF"/>
        </Style>
    </Style>
    
    
</Styles>


