<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CShroudApp.Desktop.ViewModels.MainPages"
             xmlns:aproperties="clr-namespace:CShroudApp.Desktop.Resources.AttachedProperties"
             xmlns:widgets="clr-namespace:CShroudApp.Desktop.Widgets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1100"
             x:DataType="vm:SettingsViewModel"
             x:Class="CShroudApp.Desktop.Views.MainPages.SettingsView"
             Background="#0A0A0A">
    
    <UserControl.Styles>
        <StyleInclude Source="avares://CShroudApp.Desktop/Assets/Styles/Default.axaml"/>
        
        <Style Selector="Border.SettingsGroup">
            <Setter Property="Background" Value="#80171717"/>
            <Setter Property="BorderBrush" Value="#262626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12.75"/>
            <Setter Property="Padding" Value="21"/>
            
            <Style Selector="^ StackPanel.SettingsGroupWrapper">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Spacing" Value="21"/>
            </Style>
            
            <Style Selector="^ StackPanel.SettingsGroupHeader">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Spacing" Value="5.25"/>
                    
                <Style Selector="^ StackPanel.SettingsGroupHeaderWrapper">
                    <Setter Property="Orientation" Value="Horizontal"/>
                    <Setter Property="Spacing" Value="7"/>
                </Style>
                
                <Style Selector="^ Svg.SettingsGroupHeaderIcon">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                
                <Style Selector="^ TextBlock.SettingsGroupHeaderTitle">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                
                <Style Selector="^ TextBlock.SettingsGroupHeaderDescription">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="#a1a1a1"/>
                </Style>
            </Style>
            
            <Style Selector="^ Grid.SettingsGroupItem">
                <Setter Property="VerticalAlignment" Value="Center"/>
                
                <Style Selector="^ ToggleSwitch.SettingsGroupItemToggleSwitch">
                    <Setter Property="Background" Value="#cc1a1a1a" />
                    <Setter Property="Foreground" Value="#ffffff" />
                
                    <Style Selector="^:checked">
                        <Setter Property="Background" Value="#ffffff" />
                        <Setter Property="Foreground" Value="#000000" />
                    </Style>
                </Style>
                
                <Style Selector="^ TextBlock.SettingsGroupItemName">
                </Style>
                
                <Style Selector="^ TextBlock.SettingsGroupItemDescription">
                    <Setter Property="Foreground" Value="#a1a1a1"/>
                    <Setter Property="FontSize" Value="12.25"/>
                    <Setter Property="LineHeight" Value="17.4999825"/>
                </Style>
            </Style>
        </Style>
    </UserControl.Styles>
    
    <StackPanel Orientation="Vertical" Spacing="28">
        
        <Border Classes="SettingsGroup">
            <StackPanel Classes="SettingsGroupWrapper">
                <StackPanel Classes="SettingsGroupHeader">
                    <StackPanel Classes="SettingsGroupHeaderWrapper">
                        <Svg Classes="SettingsGroupHeaderIcon" Path="avares://CShroudApp.Desktop/Assets/icons/svg/arrows-split.svg"
                             Css="* { stroke: #5F16FE; }"/>
                        <TextBlock Classes="SettingsGroupHeaderTitle">Advanced Features</TextBlock>
                    </StackPanel>
                    <TextBlock Classes="SettingsGroupHeaderDescription">Configure split tunneling and advanced routing options</TextBlock>
                </StackPanel>
                
                <StackPanel Spacing="21">
                    <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                        <StackPanel>
                            <TextBlock Classes="SettingsGroupItemName">Enable Split Tunneling</TextBlock>
                            <TextBlock Classes="SettingsGroupItemDescription">Allow specific apps to bypass VPN</TextBlock>
                        </StackPanel>
                    
                        <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                    </Grid>
                    
                    <Border Padding="14 0 0 0" BorderBrush="#4d5f16fe" BorderThickness="2 0 0 0">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock HorizontalAlignment="Stretch">Application Selection</TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7">
                                    
                                    <widgets:IconButton Content="Collapse"
                                                        IconPath="avares://CShroudApp.Desktop/Assets/icons/svg/fast-forward.svg"
                                                        Classes="IconButtonType1 _SkyColor" Height="28"/>
                                    
                                    <widgets:IconButton Content="Add Custom"
                                                        IconPath="avares://CShroudApp.Desktop/Assets/icons/svg/fast-forward.svg"
                                                        Classes="IconButtonType1 _MagentaColor" Height="28"/>
                                    
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel Orientation="Vertical" Spacing="10.5">
                                
                                <Border Padding="10.5" CornerRadius="8.75" Background="#4d262626">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <ToggleButton Width="14" Height="14"></ToggleButton>
                                        <Image Width="24" Height="24" Source="avares://CShroudApp.Desktop/Assets/icons/ico/google_chrome.ico"/>
                                        <StackPanel>
                                            <TextBlock Foreground="#fff" FontWeight="500" FontSize="14" LineHeight="21">Chrome</TextBlock>
                                            <TextBlock Foreground="#a1a1a1" FontSize="10.5" LineHeight="13.999965">Using VPN</TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                                <Border Padding="10.5" CornerRadius="8.75" Background="#4d262626">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <ToggleButton Width="14" Height="14"></ToggleButton>
                                        <Image Width="24" Height="24" Source="avares://CShroudApp.Desktop/Assets/icons/ico/google_chrome.ico"/>
                                        <StackPanel>
                                            <TextBlock Foreground="#fff" FontWeight="500" FontSize="14" LineHeight="21">Chrome</TextBlock>
                                            <TextBlock Foreground="#a1a1a1" FontSize="10.5" LineHeight="13.999965">Using VPN</TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">Enable Bypass Mode</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Alternative routing mode for specific applications</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border Classes="SettingsGroup">
            <StackPanel Classes="SettingsGroupWrapper">
                <StackPanel Classes="SettingsGroupHeader">
                    <StackPanel Classes="SettingsGroupHeaderWrapper">
                        <Svg Classes="SettingsGroupHeaderIcon" Path="avares://CShroudApp.Desktop/Assets/icons/svg/monitor.svg"
                             Css="* { fill: #2F7CFF; }"/>
                        <TextBlock Classes="SettingsGroupHeaderTitle">General Settings</TextBlock>
                    </StackPanel>
                    <TextBlock Classes="SettingsGroupHeaderDescription">Configure basic application behavior and startup options</TextBlock>
                </StackPanel>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">Start on System Boot</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Launch CrimsonShroud when your computer starts</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1" IsChecked="{Binding SharedMemory.ApplicationConfig.GeneralSettings.StartOnSystemStartup}"/>
                </Grid>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">Auto Connect on Startup</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Automatically connect to Network when app launches</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">Minimize to System Tray</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Hide app in system tray when closed</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border Classes="SettingsGroup">
            <StackPanel Classes="SettingsGroupWrapper">
                <StackPanel Classes="SettingsGroupHeader">
                    <StackPanel Classes="SettingsGroupHeaderWrapper">
                        <Svg Classes="SettingsGroupHeaderIcon" Path="avares://CShroudApp.Desktop/Assets/icons/svg/padlock.svg"
                             Css="* { fill: #F02E39; }"/>
                        <TextBlock Classes="SettingsGroupHeaderTitle">Security &amp; Privacy</TextBlock>
                    </StackPanel>
                    <TextBlock Classes="SettingsGroupHeaderDescription">Configure advanced security features to protect your privacy</TextBlock>
                </StackPanel>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">Kill Switch</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Block all internet traffic if VPN disconnects</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">IPv6 Leak Protection</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Block IPv6 traffic to prevent IP leaks</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">WebRTC Blocking</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Block WebRTC to prevent real IP exposure</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border Classes="SettingsGroup">
            <StackPanel Classes="SettingsGroupWrapper">
                <StackPanel Classes="SettingsGroupHeader">
                    <StackPanel Classes="SettingsGroupHeaderWrapper">
                        <Svg Classes="SettingsGroupHeaderIcon" Path="avares://CShroudApp.Desktop/Assets/icons/svg/bell.svg"
                             Css="* { fill: #F67E47; }"/>
                        <TextBlock Classes="SettingsGroupHeaderTitle">Notifications &amp; Updates</TextBlock>
                    </StackPanel>
                    <TextBlock Classes="SettingsGroupHeaderDescription">Configure system notifications and automatic updates</TextBlock>
                </StackPanel>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">Show Notifications</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Display system notifications for VPN events</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
                
                <Grid Classes="SettingsGroupItem" ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="SettingsGroupItemName">Automatic Updates</TextBlock>
                        <TextBlock Classes="SettingsGroupItemDescription">Download and install updates automatically</TextBlock>
                    </StackPanel>
                    
                    <ToggleSwitch Classes="SettingsGroupItemToggleSwitch" Grid.Column="1"/>
                </Grid>
                
                <Border BorderBrush="#262626" BorderThickness="0 1 0 0" Padding="0 14 0 0">
                    <widgets:IconButton Content="Check for Updates" HorizontalAlignment="Stretch" Background="#2F7CFF" Padding="10.5 5"
                                        FontSize="12.25" LineHeight="17.4999825" FontWeight="400" Foreground="#ffffff" IconColor="#ffffff"
                                        IconWidth="14" IconHeight="14" Gap="10.5" CornerRadius="6.75"
                                        IconPath="avares://CShroudApp.Desktop/Assets/icons/svg/update.svg"/>
                </Border>
            </StackPanel>
        </Border>
        
    </StackPanel>
    
</UserControl>
